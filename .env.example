# Vercel Postgres Configuration
# These are automatically provided by Vercel when you add a Postgres database under Storage -> Connect to Project.
POSTGRES_URL="postgres://default:password@ep-xyz.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
POSTGRES_PRISMA_URL="postgres://default:password@ep-xyz.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require&pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgres://default:password@ep-xyz.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
POSTGRES_USER="default"
POSTGRES_HOST="ep-xyz.us-east-1.postgres.vercel-storage.com"
POSTGRES_PASSWORD="your-password"
POSTGRES_DATABASE="verceldb"

# Admin Portal Security
# Optional custom password for the /admin doctor and staff dashboard.
# If omitted, default password is "DrMokoena2025!" or whatever is configured in Practice Settings.
ADMIN_PASSWORD="DrMokoena2025!"
ADMIN_SESSION_SECRET="brooklyn-bridge-gp-secret-salt-2025"
